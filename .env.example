DATABASE_URL=postgresql://vestidor:CAMBIAR@127.0.0.1:55418/vestidor18
JWT_SECRET=GENERAR_48_BYTES_ALEATORIOS
API_PORT=3018
# Usa 0.0.0.0 únicamente para probar la aplicación móvil desde la red local.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Opcional: clave nueva sk_test_ de Stripe. Solo en el servidor; nunca en la web ni APK.
# STRIPE_SECRET_KEY=sk_test_...
STORAGE_ROOT=.local/storage
PYTHON_PATH=workers/avatar/.venv/Scripts/python.exe

# SaaS: por defecto usa DATABASE_URL para control y negocios.
# El usuario de provisión necesita CREATE DATABASE y acceso a las bases de tiendas.
# PLATFORM_DATABASE_URL=postgresql://...
# TENANT_DATABASE_URL=postgresql://...
# Provisión mediante npm run tenant:create. No guardar la contraseña en Git.
# TENANT_ADMIN_PASSWORD=...

# Acceso global separado del login de las tiendas. Opcional hasta configurarlo.
# PLATFORM_OPERATOR_USERNAME=operadora
# PLATFORM_OPERATOR_PASSWORD_HASH=bcrypt_generado_localmente
# PLATFORM_OPERATOR_JWT_SECRET=GENERAR_48_BYTES_ALEATORIOS

# Suscripciones académicas. Solo claves TEST; LIVE se rechaza.
# STRIPE_SECRET_KEY=sk_test_CONFIGURAR_EN_ENTORNO
# STRIPE_WEBHOOK_SECRET=whsec_CONFIGURAR_EN_ENTORNO
# Webhook: POST /api/billing/stripe/webhook (bytes originales).
# WEB_ORIGIN fija el retorno de Checkout. QR_SIMULATED funciona sin Stripe.

# Clave AES256 de envoltura: 32 bytes aleatorios en base64, solo servidor.
# Sin esta variable bootstrap devuelve503; nunca inventa otra clave para datos existentes.
# OFFLINE_MASTER_KEY=CONFIGURAR_BASE64_32_BYTES
# Rotación: conservar claves anteriores mientras existan registros envueltos con ellas.
# OFFLINE_WRAP_KEYS={"1":"BASE64_ANTERIOR","2":"BASE64_NUEVA"}
# OFFLINE_WRAP_KEY_VERSION=2

# Asistencia de reportes. Configurar exclusivamente en el servidor.
# REPORT_AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_REPORTS_MODEL=openai/gpt-oss-20b
# GROQ_VOICE_MODEL=whisper-large-v3-turbo
# Alternativa OpenAI:
# REPORT_AI_OPENAI_KEY=
# REPORT_AI_TEXT_MODEL=
# REPORT_AI_VOICE_MODEL=gpt-transcribe

# Worker local de análisis. Usar la ruta absoluta de su entorno Python 3.11.
# ANALYTICS_PYTHON_PATH=

# En Docker se crean venvs independientes para avatar y análisis.
# RUN_DB_SEED=false preserva los datos existentes al arrancar.
# RUN_DB_SEED=false
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
