PUBLIC_HOST=REEMPLAZAR_HOST_DE_LA_NUEVA_VM
POSTGRES_PASSWORD=GENERAR_VALOR_ALEATORIO
JWT_SECRET=GENERAR_MINIMO_48_CARACTERES_ALEATORIOS
RUN_DB_SEED=false

# Nuevas instalaciones: clave aleatoria de 32 bytes codificada en base64.
# Restauraciones: conservar la clave y TODAS las versiones existentes.
OFFLINE_MASTER_KEY=GENERAR_BASE64_DE_32_BYTES
OFFLINE_WRAP_KEY_VERSION=1
OFFLINE_WRAP_KEYS=

PLATFORM_OPERATOR_USERNAME=operador
# Mantener comillas simples para que Compose no interpole los signos $ de bcrypt.
PLATFORM_OPERATOR_PASSWORD_HASH='GENERAR_HASH_BCRYPT'
PLATFORM_OPERATOR_JWT_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO

# Opcionales, solo cuentas de prueba autorizadas. Nunca publicar en web/APK.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REPORT_AI_OPENAI_KEY=
REPORT_AI_TEXT_MODEL=
REPORT_AI_VOICE_MODEL=
